{
  "name": "aegis-blocker",
  "private": false,
  "version": "2.0.1",
  "description": "Strict, private, 100% local website blocker for deep work (Chromium, Manifest V3).",
  "type": "module",
  "author": "Ordreth <contact@ordreth.com>",
  "license": "MIT",
  "homepage": "https://ordreth.com/apps/aegis/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ordreth/aegis-blocker.git"
  },
  "bugs": {
    "url": "https://github.com/ordreth/aegis-blocker/issues"
  },
  "keywords": [
    "focus",
    "website-blocker",
    "productivity",
    "chrome-extension",
    "manifest-v3",
    "declarativenetrequest"
  ],
  "packageManager": "pnpm@11.28.11",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "zip": "rm -f aegis-blocker.zip && pnpm build && cd dist && zip -qr ../aegis-blocker.zip .",
    "icons": "node scripts/icons.mjs",
    "assets": "pnpm build && vitest run --config vitest.assets.config.ts && node scripts/assets/shots.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "pngjs": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
